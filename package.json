{
  "name": "telex",
  "version": "0.1.0",
  "description": "MCP server that lets local AI agents ask users questions through Telegram bots",
  "type": "module",
  "bin": {
    "telex": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "telex": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "config.example.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sojaner/telex.git"
  }
}
